# MongoDB
MONGODB_ADMINUSERNAME=admin
MONGODB_ADMINPASSWORD=change-me
MONGODB_URL=mongodb://admin:change-me@mongo:27017
MONGODB_DB=fastapi_shop
MONGODB_MAX_POOL=20
MONGODB_MIN_POOL=2
MONGODB_TIMEOUT_MS=5000

# Celery
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/3

# App
CORS_ORIGINS=http://localhost,http://localhost:8080
ALLOWED_ORIGINS=
SETUP_TOKEN_EXPIRE_MINUTES=15
CART_EXPIRE_HOURS=1
